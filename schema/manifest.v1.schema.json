{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termy.dev/schemas/plugin-manifest.v1.json",
  "title": "Termy Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "termyApiVersion",
    "entry",
    "capabilities",
    "contributes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "termyApiVersion": {
      "const": "1"
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+\\.js$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "hosts.read",
          "snippets.read",
          "terminal.write"
        ]
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "panes"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pane"
          }
        }
      }
    }
  },
  "$defs": {
    "contributionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contributionId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contributionId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
